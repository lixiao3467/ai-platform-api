# AI Platform API — Environment Variables
# Copy to .env and fill in real values
# In production, inject via Railway Variables or platform secrets

# --- Application ---
APP_NAME=ai-platform
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-me-in-production-use-a-random-64-char-string

# --- PostgreSQL (Neon.tech) ---
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname?sslmode=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# --- Redis (Upstash) ---
REDIS_URL=rediss://default:password@host:6379
REDIS_PASSWORD=

# --- Milvus (Zilliz Cloud) ---
MILVUS_URI=https://your-cluster.vectordb.zillizcloud.com
MILVUS_TOKEN=your-token-here

# --- Elasticsearch (Bonsai) ---
ELASTICSEARCH_URL=https://user:password@host.bonsaisearch.net

# --- Backblaze B2 (S3 Compatible) ---
MINIO_ENDPOINT=https://s3.us-east-005.backblazeb2.com
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=ai-platform

# --- LiteLLM AI Gateway ---
LITELLM_API_BASE=http://localhost:4000
LITELLM_MASTER_KEY=sk-litellm-master-key

# --- Embedding ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- JWT Auth ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Langfuse (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=1000
RATE_LIMIT_WINDOW_SECONDS=60
